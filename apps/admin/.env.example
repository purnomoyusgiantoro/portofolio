# Supabase Configuration for Admin Panel
# Get these from: Supabase Dashboard -> Project Settings -> API
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Public Anon Key (for admin user login and session management)
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# Service Role Secret Key (used for storage bypass & elevated administrative operations)
# CAUTION: Never commit real keys to git or use in public apps
VITE_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

VITE_ENABLE_SIGNUP=false
